<% layout('layout', { title: t('pageTitles.admin') }) %>
<section class="space-y-10">
  <header class="space-y-3">
    <h1 class="text-3xl font-semibold text-white sm:text-4xl"><%= t('adminDashboard.heading') %></h1>
    <p class="max-w-3xl text-sm text-slate-400 sm:text-base"><%= t('adminDashboard.description') %></p>
  </header>

  <section class="rounded-3xl border border-white/5 bg-slate-950/40 p-6 shadow-inner shadow-slate-950/40">
    <h2 class="text-xl font-semibold text-white"><%= t('adminDashboard.introHeading') %></h2>
    <p class="mt-1 text-sm text-slate-400"><%= t('adminDashboard.introDescription') %></p>
    <form method="POST" action="/admin/settings/intro" class="mt-6 space-y-5">
      <div class="grid gap-4 md:grid-cols-2">
        <% availableLocales.forEach(code => { %>
          <label class="space-y-2 text-sm text-slate-200">
            <span class="font-medium"><%= t('adminDashboard.introLabel', { language: t('lang.' + code) }) %></span>
            <textarea name="intro_<%= code %>" rows="4" class="block w-full rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/50"><%= introContent[code] || '' %></textarea>
          </label>
        <% }) %>
      </div>
      <div class="flex justify-end">
        <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-sky-500 px-5 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-sky-500/20 transition hover:bg-sky-400"><%= t('adminDashboard.saveIntro') %></button>
      </div>
    </form>
  </section>

  <div class="grid gap-6 lg:grid-cols-2">
    <form method="POST" action="/admin/slots/bulk" class="rounded-3xl border border-white/5 bg-slate-950/40 p-6 shadow-inner shadow-slate-950/40">
      <h2 class="text-xl font-semibold text-white"><%= t('adminDashboard.bulkHeading') %></h2>
      <p class="mt-1 text-sm text-slate-400"><%= t('adminDashboard.bulkDescription') %></p>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <label class="space-y-2 text-sm text-slate-200"><%= t('adminDashboard.date') %>
          <input type="date" name="date" required class="block w-full rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3 text-sm text-white focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/50" />
        </label>
        <label class="space-y-2 text-sm text-slate-200"><%= t('adminDashboard.start') %>
          <input type="time" name="start" required class="block w-full rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3 text-sm text-white focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/50" />
        </label>
        <label class="space-y-2 text-sm text-slate-200"><%= t('adminDashboard.end') %>
          <input type="time" name="end" required class="block w-full rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3 text-sm text-white focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/50" />
        </label>
        <label class="space-y-2 text-sm text-slate-200"><%= t('adminDashboard.duration') %>
          <input type="number" name="duration" value="20" min="5" step="5" required class="block w-full rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3 text-sm text-white focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/50" />
        </label>
      </div>
      <button type="submit" class="mt-6 inline-flex items-center gap-2 rounded-full bg-sky-500 px-5 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-sky-500/20 transition hover:bg-sky-400"><%= t('buttons.generate') %></button>
    </form>

    <form method="POST" action="/admin/slots/create" class="rounded-3xl border border-white/5 bg-slate-950/40 p-6 shadow-inner shadow-slate-950/40">
      <h2 class="text-xl font-semibold text-white"><%= t('adminDashboard.singleHeading') %></h2>
      <p class="mt-1 text-sm text-slate-400"><%= t('adminDashboard.singleDescription') %></p>
      <div class="mt-6 grid gap-4">
        <label class="space-y-2 text-sm text-slate-200"><%= t('adminDashboard.singleStart') %>
          <input name="start_time" placeholder="<%= t('placeholders.startIso') %>" required class="block w-full rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/50" />
        </label>
        <label class="space-y-2 text-sm text-slate-200"><%= t('adminDashboard.singleEnd') %>
          <input name="end_time" placeholder="<%= t('placeholders.endIso') %>" required class="block w-full rounded-2xl border border-slate-700/60 bg-slate-900/60 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/50" />
        </label>
      </div>
      <button type="submit" class="mt-6 inline-flex items-center gap-2 rounded-full bg-emerald-500 px-5 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-emerald-500/20 transition hover:bg-emerald-400"><%= t('buttons.createSlot') %></button>
    </form>
  </div>

  <section class="space-y-4">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-2xl font-semibold text-white sm:text-3xl"><%= t('adminDashboard.listHeading') %></h2>
        <p class="text-sm text-slate-400"><%= t('adminDashboard.listDescription') %></p>
      </div>
      <span class="inline-flex items-center gap-2 rounded-full border border-slate-700/70 bg-slate-900/60 px-4 py-2 text-xs font-medium uppercase tracking-wide text-slate-300"><%= t('adminDashboard.totalLabel') %>: <%= slots.length %></span>
    </div>

    <div class="overflow-hidden rounded-3xl border border-white/5 bg-slate-950/30">
      <table class="min-w-full divide-y divide-white/5 text-left text-sm text-slate-200">
        <thead class="bg-slate-900/60 text-xs uppercase tracking-wide text-slate-400">
          <tr>
            <th class="px-4 py-4"><%= t('table.start') %></th>
            <th class="px-4 py-4"><%= t('table.end') %></th>
            <th class="px-4 py-4"><%= t('table.status') %></th>
            <th class="px-4 py-4"><%= t('table.name') %></th>
            <th class="px-4 py-4"><%= t('table.email') %></th>
            <th class="px-4 py-4"><%= t('table.phone') %></th>
            <th class="px-4 py-4"><%= t('table.note') %></th>
            <th class="px-4 py-4"><%= t('table.actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% slots.forEach(s => { const isBooked = Boolean(s.booked_by_name); %>
            <tr class="align-top transition hover:bg-slate-900/50">
              <td class="px-4 py-4 font-medium text-white"><%= s.start_time.replace('T',' ') %></td>
              <td class="px-4 py-4 text-slate-300"><%= s.end_time.replace('T',' ') %></td>
              <td class="px-4 py-4">
                <% if (isBooked) { %>
                  <span class="inline-flex items-center gap-2 rounded-full border border-rose-400/40 bg-rose-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-rose-100"><%= t('status.booked') %></span>
                <% } else { %>
                  <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/40 bg-emerald-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-100"><%= t('status.free') %></span>
                <% } %>
              </td>
              <td class="px-4 py-4 text-sm text-slate-100"><%- s.booked_by_name || '&mdash;' %></td>
              <td class="px-4 py-4 text-sm text-slate-300"><%- s.booked_by_email || '&mdash;' %></td>
              <td class="px-4 py-4 text-sm text-slate-300"><%- s.booked_by_phone || '&mdash;' %></td>
              <td class="px-4 py-4">
                <form method="POST" action="/admin/slot/<%= s.id %>/note" class="flex flex-col gap-3 sm:flex-row">
                  <input name="note" value="<%= s.note || '' %>" placeholder="<%= t('placeholders.note') %>" class="w-full rounded-2xl border border-slate-700/60 bg-slate-900/60 px-3 py-2 text-xs text-slate-100 placeholder:text-slate-500 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/40" />
                  <button class="inline-flex items-center justify-center rounded-full border border-slate-600/60 px-4 py-2 text-xs font-semibold text-slate-200 transition hover:border-slate-400/60"><%= t('buttons.saveNote') %></button>
                </form>
              </td>
              <td class="relative px-4 py-4">
                <details class="group relative inline-block text-left">
                  <summary class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-slate-700/70 bg-slate-900/70 text-slate-300 transition hover:border-slate-500/70 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400" aria-haspopup="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
                      <circle cx="12" cy="5" r="1.8" />
                      <circle cx="12" cy="12" r="1.8" />
                      <circle cx="12" cy="19" r="1.8" />
                    </svg>
                    <span class="sr-only"><%= t('adminDashboard.actionMenuTitle') %> — <%= s.start_time.replace('T',' ') %></span>
                  </summary>
                  <div class="absolute right-0 z-20 mt-2 w-72 overflow-hidden rounded-2xl border border-white/5 bg-slate-900/95 shadow-xl shadow-slate-950/40 backdrop-blur">
                    <div class="border-b border-white/5 px-4 py-3 text-xs text-slate-400">
                      <p class="text-slate-300"><%= t('adminDashboard.actionMenuTitle') %></p>
                      <p><span class="text-slate-200"><%= s.start_time.replace('T',' ') %></span> — <span class="text-slate-200"><%= s.end_time.replace('T',' ') %></span></p>
                    </div>

                    <% if (!isBooked) { %>
                      <div class="space-y-3 px-4 py-4">
                        <p class="text-xs text-slate-400"><%= t('adminDashboard.bookExplanation') %></p>
                        <form method="POST" action="/admin/slot/<%= s.id %>/book" class="space-y-2">
                          <input name="name" placeholder="<%= t('placeholders.name') %>" required class="w-full rounded-xl border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/40" />
                          <input type="email" name="email" placeholder="<%= t('placeholders.email') %>" required class="w-full rounded-xl border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/40" />
                          <input name="phone" placeholder="<%= t('placeholders.phone') %>" required class="w-full rounded-xl border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-100 placeholder:text-slate-500 focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400/40" />
                          <button class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-400/90 px-3 py-2 text-sm font-semibold text-slate-900 transition hover:bg-emerald-300">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                            </svg>
                            <%= t('buttons.bookSlot') %>
                          </button>
                        </form>
                      </div>
                    <% } else { %>
                      <div class="space-y-3 px-4 py-4">
                        <p class="text-xs text-slate-400"><%= t('adminDashboard.bookedBy', { name: s.booked_by_name }) %></p>
                        <form method="POST" action="/admin/slot/<%= s.id %>/clear" class="flex items-center justify-between gap-3">
                          <span class="text-xs text-slate-500"><%= t('adminDashboard.clearHint') %></span>
                          <button class="inline-flex items-center gap-2 rounded-xl bg-rose-500 px-3 py-2 text-xs font-semibold text-white transition hover:bg-rose-400" type="submit">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-9A2.25 2.25 0 002.25 5.25v13.5A2.25 2.25 0 004.5 21h9a2.25 2.25 0 002.25-2.25V15" />
                              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h12m0 0l-3-3m3 3l-3 3" />
                            </svg>
                            <%= t('buttons.clearSlot') %>
                          </button>
                        </form>
                      </div>
                    <% } %>

                    <div class="border-t border-white/5 px-4 py-3">
                      <form method="POST" action="/admin/slot/<%= s.id %>/delete" class="inline-flex w-full items-center justify-between gap-3">
                        <span class="text-xs text-slate-500"><%= t('adminDashboard.deleteHint') %></span>
                        <button type="submit" class="inline-flex items-center gap-2 rounded-xl border border-rose-400/60 bg-rose-500/10 px-3 py-2 text-xs font-semibold text-rose-200 transition hover:bg-rose-500/20">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 4.5l-.867 12.138A2.25 2.25 0 0116.386 18.75H7.614a2.25 2.25 0 01-2.247-2.112L4.5 4.5m5.25 0V3.75A1.5 1.5 0 0111.25 2.25h1.5a1.5 1.5 0 011.5 1.5V4.5m-9 0h12" />
                          </svg>
                          <%= t('buttons.deleteSlot') %>
                        </button>
                      </form>
                    </div>
                  </div>
                </details>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</section>
